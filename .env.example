# =============================================================================
# SATELLITE PLATFORM APPLICATION - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting services: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE & CACHE (MongoDB & Redis)
# -----------------------------------------------------------------------------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your_secure_mongo_password_here
MONGO_DATABASE=satellitedb
MONGO_PORT=27017

REDIS_PORT=6379
REDIS_MAX_MEMORY=512mb

# -----------------------------------------------------------------------------
# 2. MESSAGE BROKER (RabbitMQ)
# -----------------------------------------------------------------------------
RABBITMQ_USER=admin
RABBITMQ_PASS=your_secure_rabbitmq_password_here
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# 3. BACKEND SERVICE (Spring Boot)
# -----------------------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# JWT Authentication
JWT_SECRET=replace_this_with_a_random_32_character_secret_string_for_production
JWT_EXPIRATION=86400000

# Initial Admin Seed Account
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@satellite.com
ADMIN_PASSWORD=ChangeMeOnFirstLogin!123

# Python Microservices URLs (inside Docker network or host)
PYTHON_BASE_URL=http://image-processing-app:8000
GEE_BASE_URL=http://gee-service:5000
APP1_URL=http://image-processing-app:8000

# File Storage Paths (Internal Container Mounts)
PROJECT_BASE_PATH=/app
IMAGE_STORAGE_PATH=/app/upload-dir
TEMP_STORAGE_PATH=/app/tmp
